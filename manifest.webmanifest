{
  "$schema": "https://json.schemastore.org/web-manifest",
  "name": "纯白 — 白色封皮综合文学刊物",
  "short_name": "纯白",
  "description": "一份月度发布的综合文学交流成果。诗歌、小说、散文、文学评论及杂文。",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "lang": "zh-CN",
  "dir": "ltr",
  "display": "standalone",
  "background_color": "#f9f8f6",
  "theme_color": "#f9f8f6",
  "categories": ["magazines", "books", "news"],
  "icons": [
    {
      "src": "pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "pwa/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "阅读栏目",
      "short_name": "阅读",
      "description": "浏览纯白各文学栏目",
      "url": "./#columns"
    },
    {
      "name": "下载刊物",
      "short_name": "下载",
      "description": "下载 PDF 与 EPUB 版本",
      "url": "./#downloads"
    },
    {
      "name": "最新公告",
      "short_name": "公告",
      "description": "查看最新公告",
      "url": "./#announcements"
    }
  ]
}
